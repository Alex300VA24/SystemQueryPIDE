# ============================================================
# LARAVEL - GITIGNORE MEJORADO
# Compatible con: XAMPP 8.1, GitHub, cPanel / Hosting compartido
# ============================================================

# ---------- ENTORNO Y CONFIGURACIÓN SENSIBLE ----------
.env
.env.backup
.env.backup.*
.env.local
.env.*.local
.env.production
.env.staging
.env.development
.env.testing
.env.dusk
.env.dusk.local
auth.json

# ---------- DEPENDENCIAS ----------
/node_modules
/vendor
/bower_components
/.pnp
/.pnp.js
.pnp.cjs

# ---------- CACHÉ Y ARCHIVOS COMPILADOS ----------
/public/build
/public/hot
/public/storage
/storage/*.key
/bootstrap/cache/*.php
/bootstrap/cache/*.dev
/bootstrap/cache/*.stub
/.phpunit.cache
/.phpunit.result.cache
.phpunit.result.cache

# ---------- ASSETS DE PAQUETES PUBLICADOS / VENDOR (reinstalar via README / composer) ----------
/public/assets/css/fontawesome
/public/assets/css/fontawesome/
/public/vendor
/public/vendor/
/packages
/packages/

# ---------- LOGS ----------
/storage/logs/*.log
/storage/logs/*.txt
/laravel.log
*.log

# ---------- STORAGE (Datos generados en runtime) ----------
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public
/storage/app/public/*
!/storage/app/public/.gitignore

/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# ---------- DATABASE ----------
/database/*.sqlite
/database/*.sqlite3
/database/sqlite

# Datos privados importados desde sistema legado
/database/seeders/data/backup.sql
/database/seeders/data/private/
/database/seeders/data/env/
/database/seeders/data/__pycache__/
/database/seeders/data/*.private.json

